  "id": "slack-issue-bot-01",
  "name": "Slack Issue Bot",
  "active": false,
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "slack-bot",
        "options": {
          "responseMode": "responseNode"
        }
      },
      "id": "slack-bot-webhook",
      "name": "Slack Bot Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [200, 300],
      "webhookId": "slack-bot-webhook"
    },
    {
      "parameters": {
        "jsCode": "// Parse Slack slash command or mention\n// Expected formats:\n// /issue create [title] - [description]\n// /issue status #123\n// /issue comment #123 [message]\n\nconst input = $input.first().json;\nconst text = input.text || '';\nconst userId = input.user_id || '';\nconst userName = input.user_name || 'Unknown';\nconst channelId = input.channel_id || '';\n\nlet command = 'unknown';\nlet title = '';\nlet description = '';\nlet issueId = null;\nlet message = '';\n\n// Parse create command\nconst createMatch = text.match(/^create\\s+(.+?)(?:\\s*-\\s*(.*))?$/i);\nif (createMatch) {\n  command = 'create';\n  title = createMatch[1].trim();\n  description = createMatch[2] ? createMatch[2].trim() : '';\n}\n\n// Parse status command\nconst statusMatch = text.match(/^status\\s+#?(\\d+)$/i);\nif (statusMatch) {\n  command = 'status';\n  issueId = parseInt(statusMatch[1], 10);\n}\n\n// Parse comment command\nconst commentMatch = text.match(/^comment\\s+#?(\\d+)\\s+(.+)$/i);\nif (commentMatch) {\n  command = 'comment';\n  issueId = parseInt(commentMatch[1], 10);\n  message = commentMatch[2].trim();\n}\n\nreturn [{\n  json: {\n    command,\n    title,\n    description,\n    issueId,\n    message,\n    userId,\n    userName,\n    channelId,\n    originalText: text\n  }\n}];"
      },
      "id": "parse-slack-command",
      "name": "Parse Slack Command",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [400, 300]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.command }}",
              "value2": "create"
            }
          ]
        }
      },
      "id": "route-command",
      "name": "Route Command",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [600, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.GITLAB_URL }}/api/v4/projects/{{ $env.GITLAB_PROJECT_ID }}/issues",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "PRIVATE-TOKEN",
              "value": "={{ $env.GITLAB_ACCESS_TOKEN }}"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "title",
              "value": "={{ $json.title }}"
            },
            {
              "name": "description",
              "value": "={{ $json.description }}\\n\\n---\\n**Created from Slack by**: {{ $json.userName }}"
            },
            {
              "name": "labels",
              "value": "from-slack"
            }
          ]
        },
        "options": {}
      },
      "id": "create-issue-from-slack",
      "name": "Create Issue from Slack",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [850, 150]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.GITLAB_URL }}/api/v4/projects/{{ $env.GITLAB_PROJECT_ID }}/issues/{{ $json.issueId }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "PRIVATE-TOKEN",
              "value": "={{ $env.GITLAB_ACCESS_TOKEN }}"
            }
          ]
        },
        "options": {}
      },
      "id": "get-issue-status",
      "name": "Get Issue Status",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [850, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.GITLAB_URL }}/api/v4/projects/{{ $env.GITLAB_PROJECT_ID }}/issues/{{ $json.issueId }}/notes",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "PRIVATE-TOKEN",
              "value": "={{ $env.GITLAB_ACCESS_TOKEN }}"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "body",
              "value": "💬 **Slack 코멘트** by {{ $json.userName }}:\\n\\n{{ $json.message }}"
            }
          ]
        },
        "options": {}
      },
      "id": "add-comment-from-slack",
      "name": "Add Comment from Slack",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [850, 450]
    },
    {
      "parameters": {
        "respondWith": "text",
        "responseBody": "={{ $json.command === 'create' ? '✅ 이슈가 생성되었습니다! #' + $json.iid + ' - ' + $json.title : ($json.command === 'status' ? '📋 이슈 #' + $json.iid + '\\n상태: ' + $json.state + '\\n제목: ' + $json.title : '📝 코멘트가 추가되었습니다!') }}",
        "options": {}
      },
      "id": "respond-to-slack",
      "name": "Respond to Slack",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1100, 300]
    }
