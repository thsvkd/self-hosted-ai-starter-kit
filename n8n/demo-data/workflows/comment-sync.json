{
  "createdAt": "2024-12-01T00:00:00.000Z",
  "updatedAt": "2024-12-01T00:00:00.000Z",
  "id": "comment-sync-01",
  "name": "Comment Sync - Slack/Notion to GitLab",
  "active": false,
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "slack-comment",
        "options": {}
      },
      "id": "slack-comment-webhook",
      "name": "Slack Comment Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [200, 200],
      "webhookId": "slack-comment-webhook"
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "notion-comment",
        "options": {}
      },
      "id": "notion-comment-webhook",
      "name": "Notion Comment Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [200, 400],
      "webhookId": "notion-comment-webhook"
    },
    {
      "parameters": {
        "jsCode": "// Parse incoming comment data and extract GitLab issue ID\n// Expected input: { text: string, author: string, gitlab_issue_id: number, source: 'slack' | 'notion' }\n\nconst input = $input.first().json;\n\nconst comment = {\n  text: input.text || input.comment || '',\n  author: input.author || input.user_name || 'Unknown',\n  gitlabIssueId: input.gitlab_issue_id || input.issue_id,\n  projectId: input.project_id || $env.GITLAB_PROJECT_ID,\n  source: input.source || 'external',\n  timestamp: new Date().toISOString()\n};\n\nif (!comment.gitlabIssueId) {\n  throw new Error('GitLab issue ID is required');\n}\n\nreturn [{ json: comment }];"
      },
      "id": "parse-comment-data",
      "name": "Parse Comment Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [450, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.GITLAB_URL }}/api/v4/projects/{{ $json.projectId }}/issues/{{ $json.gitlabIssueId }}/notes",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "PRIVATE-TOKEN",
              "value": "={{ $env.GITLAB_ACCESS_TOKEN }}"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "body",
              "value": "💬 **{{ $json.source }}에서 받은 코멘트**\\n\\n**작성자**: {{ $json.author }}\\n**시간**: {{ $json.timestamp }}\\n\\n---\\n\\n{{ $json.text }}"
            }
          ]
        },
        "options": {}
      },
      "id": "add-gitlab-comment",
      "name": "Add GitLab Comment",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [700, 300]
    },
    {
      "parameters": {
        "channel": "={{ $env.SLACK_CHANNEL }}",
        "text": "📝 코멘트가 GitLab 이슈 #{{ $json.gitlabIssueId }}에 추가되었습니다.\\n\\n*작성자*: {{ $json.author }}\\n*내용*: {{ $json.text }}",
        "otherOptions": {}
      },
      "id": "notify-slack-comment-added",
      "name": "Notify Comment Added",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.2,
      "position": [950, 300],
      "credentials": {
        "slackApi": {
          "id": "slack-api-cred",
          "name": "Slack API"
        }
      }
    }
  ],
  "connections": {
    "Slack Comment Webhook": {
      "main": [
        [
          {
            "node": "Parse Comment Data",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Notion Comment Webhook": {
      "main": [
        [
          {
            "node": "Parse Comment Data",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Parse Comment Data": {
      "main": [
        [
          {
            "node": "Add GitLab Comment",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Add GitLab Comment": {
      "main": [
        [
          {
            "node": "Notify Comment Added",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "staticData": null,
  "meta": {
    "templateCredsSetupCompleted": false,
    "instanceId": "comment-sync"
  },
  "pinData": {},
  "versionId": "1.0.0",
  "triggerCount": 0,
  "tags": [
